{
  "name": "debugforge",
  "version": "1.0.0",
  "description": "DebugForge: Autonomous AI Debugging Agent Harness — Reproduce, Diagnose & Auto-Heal in Sandboxes",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm --prefix packages/core run build && npm --prefix packages/cli run build",
    "build:web": "npm --prefix packages/web run build",
    "build:all": "npm --prefix packages/core run build && npm --prefix packages/cli run build && npm --prefix packages/web run build",
    "mcp": "node packages/core/dist/mcp/http-server.js",
    "dev": "npm --prefix packages/web run dev",
    "test": "node --test packages/core/dist/tests/core.test.js packages/core/dist/tests/adversarial.test.js packages/core/dist/tests/trueforge-integration.test.js packages/core/dist/tests/trueforge-live.test.js",
    "test:live": "node -e \"process.env.TRUEFORGE_LIVE_TEST='true'; require('child_process').execSync('node --test packages/core/dist/tests/trueforge-live.test.js', { stdio: 'inherit' });\"",
    "test:provider": "node -e \"process.env.REAL_PROVIDER_TEST='true'; require('child_process').execSync('node --test packages/core/dist/tests/provider-smoke.test.js', { stdio: 'inherit' });\"",
    "diagnose": "node packages/cli/dist/index.js diagnose",
    "watch": "node packages/cli/dist/index.js watch",
    "agent": "node packages/cli/dist/index.js agent",
    "demo:null": "node packages/cli/dist/index.js diagnose --target fixtures/null-propagation-api",
    "demo:race": "node packages/cli/dist/index.js diagnose --target fixtures/race-condition-app",
    "demo:memory": "node packages/cli/dist/index.js diagnose --target fixtures/memory-leak-server",
    "clean": "rimraf packages/*/dist packages/*/tsconfig.tsbuildinfo"
  },
  "keywords": [
    "debugging",
    "ai-agent",
    "trueforge",
    "daytona",
    "qodo",
    "autonomous-debugging",
    "root-cause-analysis",
    "auto-heal"
  ],
  "author": "Priyanshu",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.4",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@truefoundry/trueforge": "^0.1.4"
  }
}
